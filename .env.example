# Browser/server
HOST=0.0.0.0
PORT=3000
PUBLIC_PORT=3000
LOG_LEVEL=info
# Required whenever production listens beyond loopback. Use 24+ random
# characters and enter the same token in the browser unlock screen.
APP_AUTH_TOKEN=replace-with-a-long-random-demo-token

# Model provider. GLM is the default; set MODEL_PROVIDER=ark to switch back to
# Volcengine without changing application code.
MODEL_PROVIDER=glm

# Zhipu GLM Responses API. ZAI_API_KEY is accepted as an alias for GLM_API_KEY.
GLM_API_KEY=replace-with-your-glm-api-key
GLM_MODEL=glm-5.3
GLM_BASE_URL=https://open.bigmodel.cn/api/v1

# Volcengine Ark. Used when MODEL_PROVIDER=ark. ARK_MODEL is an endpoint/model
# ID that supports the OpenAI-compatible Responses API, for example ep-xxxxxxxx.
ARK_API_KEY=replace-with-your-ark-api-key
ARK_MODEL=ep-replace-with-your-endpoint-id
ARK_BASE_URL=https://ark.cn-beijing.volces.com/api/v3

# Runtime paths (Docker defaults are already correct).
APP_DATA_DIR=/app/data
AGENT_WORKSPACE_ROOT=/app/workspaces
CODEX_HOME=/app/codex-home
CODEX_BIN=codex

# Codex runs inside the dedicated ECS/container boundary. Startup keeps
# workspace-write when Landlock is supported and falls back to
# danger-full-access inside the outer container on kernels without Landlock.
# The fallback has no per-Agent filesystem isolation; use a scoped demo model
# key and do not place unrelated credentials or data in this POC.
CODEX_SANDBOX_MODE=workspace-write
CODEX_TIMEOUT_MS=600000
CODEX_MAX_OUTPUT_BYTES=2097152

# Runtime provider. The ECS/Compose image uses local-process because Codex is
# installed in the application container. scripts/start-local-poc.sh overrides
# this to container and starts a disposable Docker/Colima/Podman Runtime.
RUNTIME_PROVIDER=local-process
CONTAINER_ENGINE=docker
CONTAINER_RUNTIME_IMAGE=volc-agent-runtime:local
# Optional build mirrors for networks that cannot reach Docker Hub or
# deb.debian.org. Leave empty on normal networks.
CONTAINER_RUNTIME_BASE_IMAGE=node:22-bookworm-slim
CONTAINER_APT_MIRROR=
CONTAINER_APT_SECURITY_MIRROR=
# Optional extra tools, for example append: python3 build-essential
CONTAINER_RUNTIME_APT_PACKAGES=ca-certificates git ripgrep
CONTAINER_CPU_LIMIT=2
CONTAINER_MEMORY_LIMIT=2g
CONTAINER_PIDS_LIMIT=256
RUNTIME_INSTANCE_ID=default

# --- Middleware: capability budget, credential broker, policy enforcement ---
# The control plane never hands the Ark key to the Runtime. It mints a run-scoped token
# and proxies model traffic through this port, which is also the ONLY endpoint a Runtime
# container can reach once it is on the internal network.
BROKER_HOST=0.0.0.0
BROKER_PORT=3001
# Isolated, internal (no default route) network for Runtime containers.
RUNTIME_NETWORK=launchpad-runtime
# Ceiling for one turn. An Agent policy may narrow these, never widen them.
MAX_STEPS_PER_RUN=40
MAX_MODEL_CALLS_PER_RUN=80
# enforce = abort the turn on a policy violation. monitor = record it and continue.
POLICY_ENFORCEMENT=enforce
# L1's advisory preamble telling a cooperative model what the frozen budget is. Set to
# `off` to demonstrate that L2 and L3 hold on their own — an adaptive attacker's model
# ignores the preamble regardless, so `off` is the honest way to exercise enforcement.
SPOTLIGHT_PREAMBLE=on
# Only needed when the control plane runs in a container and launches sibling Runtime
# containers (see docker-compose.enforce.yml); the engine resolves mounts on the host.
# RUNTIME_HOST_WORKSPACE_ROOT=/absolute/host/path/workspaces
# RUNTIME_HOST_CODEX_HOME=/absolute/host/path/codex-home
# CONTAINER_USER is filled with the host UID:GID by start-local-poc.sh.
# CONTAINER_USER=1000:1000
